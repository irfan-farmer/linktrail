{
  "name": "linktrail",
  "version": "1.3.0",
  "description": "Cross-browser extension that keeps a private, searchable history of every link you've had open. Everything stays on your device.",
  "type": "module",
  "main": "background.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/parse_js.cjs && node --test tests/*.test.js",
    "icons": "node scripts/make-icons.cjs",
    "build": "node scripts/build.cjs"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "history",
    "productivity"
  ],
  "author": "irfan-farmer",
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.17.0"
  }
}
