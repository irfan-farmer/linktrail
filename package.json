{
  "name": "linktrail",
  "version": "1.4.0",
  "description": "Cross-browser extension that keeps a private, searchable history of every link you've had open. Everything stays on your device.",
  "type": "module",
  "main": "background.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "eslint . && node --test tests/*.test.js",
    "test:e2e": "node scripts/build.cjs && node --test --test-concurrency=1 tests/e2e/*.e2e.js",
    "icons": "node scripts/make-icons.cjs",
    "build": "node scripts/build.cjs"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "history",
    "productivity"
  ],
  "author": "irfan-farmer",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
